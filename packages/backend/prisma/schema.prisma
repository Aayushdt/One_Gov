// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Citizens ──────────────────────────────────────────────────────────────

model Citizen {
  id             String   @id @default(uuid())
  onegovId       String   @unique
  email          String   @unique
  passwordHash   String
  name           String
  phone          String?
  dateOfBirth    String?
  gender         String?
  state          String?
  district       String?
  pincode        String?
  primaryAddress String?
  createdAt      DateTime @default(now())

  identityMap  IdentityMap?
  consents     ConsentArtefact[]
  workflows    WorkflowRun[]
  auditEntries AuditEntry[]
}

// ─── Identity Mapping Table (Federated Mapping Across 8 Depts) ─────────────

model IdentityMap {
  id              String  @id @default(uuid())
  citizenId       String  @unique
  citizen         Citizen @relation(fields: [citizenId], references: [id])

  identityDeptId  String  // SIM-AADHAAR-XXXXXX
  revenueDeptId   String  // SIM-PAN-XXXXXX
  educationDeptId String  // SIM-EDU-XXXXXX
  transportDeptId String? // SIM-DL-XXXXXX
  policeDeptId    String? // SIM-POL-XXXXXX
  bankingDeptId   String? // SIM-BANK-XXXXXX
  welfareDeptId   String? // SIM-WEL-XXXXXX
  municipalDeptId String? // SIM-PROP-XXXXXX
}

// ─── Consent Artefact — ONE ROW PER CATEGORY ──────────────────────────────

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DataCategory {
  IDENTITY
  EDUCATION
  INCOME
  TRANSPORT
  POLICE
  BANKING
  WELFARE
  MUNICIPAL
}

model ConsentArtefact {
  id            String        @id @default(uuid())
  citizenId     String
  citizen       Citizen       @relation(fields: [citizenId], references: [id])
  category      DataCategory
  purpose       String
  requestedBy   String
  grantedAt     DateTime      @default(now())
  expiresAt     DateTime
  status        ConsentStatus @default(ACTIVE)
  revokedAt     DateTime?

  workflowRunId String
  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id])

  @@unique([workflowRunId, category])
  @@index([citizenId, category, status])
}

// ─── Workflow State Machine ────────────────────────────────────────────────

enum WorkflowState {
  AWAITING_CONSENT
  IDENTITY_VERIFY
  EDUCATION_VERIFY
  INCOME_VERIFY
  TRANSPORT_VERIFY
  POLICE_VERIFY
  BANKING_VERIFY
  MUNICIPAL_VERIFY
  WELFARE_VERIFY
  ELIGIBILITY_CALC
  SUBMITTED
  FAILED
  PENDING
}

model WorkflowRun {
  id             String        @id @default(uuid())
  citizenId      String
  citizen        Citizen       @relation(fields: [citizenId], references: [id])
  serviceType    String        @default("SCHOLARSHIP")
  state          WorkflowState @default(AWAITING_CONSENT)
  retryCount     Int           @default(0)
  lastError      String?
  failureReason  String?
  eligibleResult Boolean?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  identitySnapshot  Json?
  educationSnapshot Json?
  incomeSnapshot    Json?
  transportSnapshot Json?
  policeSnapshot    Json?
  bankingSnapshot   Json?
  welfareSnapshot   Json?
  municipalSnapshot Json?

  consents     ConsentArtefact[]
  stateHistory WorkflowStateHistory[]
}

model WorkflowStateHistory {
  id         String        @id @default(uuid())
  runId      String
  run        WorkflowRun   @relation(fields: [runId], references: [id])
  fromState  WorkflowState
  toState    WorkflowState
  occurredAt DateTime      @default(now())
  metadata   Json?
}

// ─── Audit Trail — Per-Citizen Hash Chain ─────────────────────────────────

model AuditEntry {
  id         String   @id @default(uuid())
  seq        Int
  citizenId  String
  citizen    Citizen  @relation(fields: [citizenId], references: [id])
  eventType  String
  actor      String
  payload    Json
  payloadRaw String
  prevHash   String
  hash       String
  createdAt  DateTime @default(now())

  @@unique([citizenId, seq])
  @@index([citizenId, seq])
}
